# Private data: message store, local config, logs. Never commit.
data/
config/*.local.yaml
config/*.local.json
config/*.tmp
*.pem
logs/
# Runtimes
.venv/
node_modules/
__pycache__/
*.pyc

# Desktop runtime (also protect custom databases located outside data/).
desktop-*.lock
desktop-*.open
desktop-*.local.json
desktop-*.tmp
desktop-*.ico
desktop-*.webview/

# Generated snapshots, including custom backup directories inside this repository.
hub-*.sqlite3
.pending-*.db*
.latest-*.tmp
backup.lock
